# Heartbox — git-delta (include in ~/.gitconfig)
[delta]
    syntax-theme = Heartbox
    plus-style = syntax "#5A8A42"
    minus-style = syntax "#E5141A"
    plus-emph-style = syntax bold "#5A8A42"
    minus-emph-style = syntax bold "#E5141A"
    line-numbers-left-style = "#3D2F2D"
    line-numbers-right-style = "#3D2F2D"
    line-numbers-minus-style = "#E5141A"
    line-numbers-plus-style = "#5A8A42"
    line-numbers-zero-style = "#7A656A"
    map-styles = bold purple => syntax "#6B4A58", bold blue => syntax "#0888ED", bold cyan => syntax "#0888ED", bold yellow => syntax "#D4B84A"
