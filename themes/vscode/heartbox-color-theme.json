{
  "name": "Heartbox",
  "type": "dark",
  "colors": {
    "editor.background": "#090909",
    "editor.foreground": "#EDE6DE",
    "editor.lineHighlightBackground": "#1C1617",
    "editor.selectionBackground": "#56180A",
    "editorCursor.foreground": "#B8BEC2",
    "editorLineNumber.foreground": "#3A3232",
    "editorLineNumber.activeForeground": "#B8BEC2",
    "sideBar.background": "#141011",
    "sideBar.foreground": "#EDE6DE",
    "activityBar.background": "#090909",
    "activityBar.foreground": "#B8BEC2",
    "statusBar.background": "#1C1617",
    "statusBar.foreground": "#EDE6DE",
    "statusBar.debuggingBackground": "#D44A18",
    "tab.activeBackground": "#1C1617",
    "tab.inactiveBackground": "#090909",
    "tab.activeForeground": "#EDE6DE",
    "tab.inactiveForeground": "#8A7874",
    "tab.activeBorderTop": "#D44A18",
    "titleBar.activeBackground": "#090909",
    "titleBar.activeForeground": "#EDE6DE",
    "panel.background": "#141011",
    "panel.border": "#3A3232",
    "focusBorder": "#D44A18",
    "button.background": "#D44A18",
    "button.foreground": "#EDE6DE",
    "list.activeSelectionBackground": "#56180A",
    "list.hoverBackground": "#1C1617",
    "list.highlightForeground": "#1E78C8",
    "terminal.background": "#090909",
    "terminal.foreground": "#EDE6DE",
    "terminal.ansiBlack": "#090909",
    "terminal.ansiRed": "#D44A18",
    "terminal.ansiGreen": "#3D8A48",
    "terminal.ansiYellow": "#C49A3C",
    "terminal.ansiBlue": "#1E78C8",
    "terminal.ansiMagenta": "#C47A72",
    "terminal.ansiCyan": "#3A94D8",
    "terminal.ansiWhite": "#EDE6DE",
    "terminal.ansiBrightBlack": "#3A3232",
    "terminal.ansiBrightRed": "#E86022",
    "terminal.ansiBrightGreen": "#5AA05A",
    "terminal.ansiBrightYellow": "#D4B85A",
    "terminal.ansiBrightBlue": "#3A94D8",
    "terminal.ansiBrightMagenta": "#D49A94",
    "terminal.ansiBrightCyan": "#6AACC8",
    "terminal.ansiBrightWhite": "#E8E2D8",
    "gitDecoration.addedResourceForeground": "#3D8A48",
    "gitDecoration.deletedResourceForeground": "#D44A18",
    "gitDecoration.modifiedResourceForeground": "#C49A3C"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#8A7874",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#C49A3C"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#C45A20"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#C47A72"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#1E78C8"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#3D8A48"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#EDE6DE"
      }
    },
    {
      "scope": [
        "constant"
      ],
      "settings": {
        "foreground": "#454B93"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#D44A18"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#3D8A48"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B8BEC2"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#D44A18"
      }
    }
  ]
}
