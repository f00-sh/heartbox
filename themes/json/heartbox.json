{
  "name": "Heartbox",
  "author": "f00",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Hand-tinted Technicolor dark theme sampled from the Heart-Shaped Box video treatment — verse sky, chorus blood, hospital-night soil, flesh dust, and cool silver metal.",
  "aesthetic": {
    "feel": [
      "hand-tinted Technicolor over black-and-white",
      "hyper-real poppy red against night soil",
      "verse sky blue / chorus blood red shift",
      "anatomical pink and bruise purple",
      "subtle cool silver metal accent",
      "hospital-room blacks with warm dust"
    ],
    "inspiration": "Color sampled from frames of the 1993 Heart-Shaped Box music video treatment (hand-painted Technicolor, poppy field, sky/box color shifts). Original palette work; not affiliated with the band or video rights holders.",
    "source_method": "k-means on frames of local source video + hand curation for UI roles"
  },
  "colors": {
    "background": {
      "hex": "#191413",
      "rgb": [25, 20, 19],
      "hsl": [12, 14, 9],
      "role": "Hospital-night underpaint; deep warm black from video soil"
    },
    "current_line": {
      "hex": "#3D2F2D",
      "rgb": [61, 47, 45],
      "hsl": [9, 15, 21],
      "role": "Surface / line highlight"
    },
