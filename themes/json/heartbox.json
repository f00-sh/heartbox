{
  "name": "Heartbox",
  "author": "f00",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Hand-tinted Technicolor dark theme — poppy fields, hospital gloom, verse-sky blue, chorus red, and a cool silver like a worn metal jacket.",
  "aesthetic": {
    "feel": [
      "hand-tinted Technicolor over black-and-white",
      "hyper-real poppy red against night soil",
      "verse sky blue / chorus blood red shift",
      "anatomical pink and bruise purple",
      "subtle cool silver metal accent",
      "hospital-room blacks with warm dust"
    ],
    "inspiration": "Color and atmosphere of the 1993 Heart-Shaped Box music video treatment (hand-painted Technicolor, poppy field, sky/box color shifts). Original work; not affiliated with the band or video rights holders."
  },
  "colors": {
    "background": {
      "hex": "#1A1214",
      "rgb": [26, 18, 20],
      "hsl": [348, 18, 9],
      "role": "Hospital-night underpaint; deep warm black"
    },
    "current_line": {
      "hex": "#2C1F22",
      "rgb": [44, 31, 34],
      "hsl": [346, 17, 15],
      "role": "Surface / line highlight"
    },
    "selection": {
      "hex": "#3A2428",
      "rgb": [58, 36, 40],
      "hsl": [349, 23, 18],
      "role": "Selection background"
    },
    "foreground": {
      "hex": "#F4EBE0",
      "rgb": [244, 235, 224],
      "hsl": [33, 48, 92],
      "role": "Hand-tinted cream light"
    },
    "comment": {
      "hex": "#8A6E78",
      "rgb": [138, 110, 120],
      "hsl": [339, 11, 49],
      "role": "Dusty mauve — faded paint, soft focus"
    },
    "sky": {
      "hex": "#5EC8E8",
      "rgb": [94, 200, 232],
      "hsl": [194, 75, 64],
      "role": "Verse technicolor sky / cyan"
    },
    "green": {
      "hex": "#5FBF4A",
      "rgb": [95, 191, 74],
