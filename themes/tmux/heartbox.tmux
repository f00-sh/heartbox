# Heartbox — tmux
set -g status-style "bg=#3D2F2D,fg=#E8E4DC"
set -g message-style "bg=#4B1006,fg=#E8E4DC"
set -g pane-border-style "fg=#3D2F2D"
set -g pane-active-border-style "fg=#E5141A"
set -g window-status-current-style "bg=#E5141A,fg=#191413,bold"
set -g window-status-style "fg=#7A656A"
set -g mode-style "bg=#4B1006,fg=#E8E4DC"
set -g clock-mode-colour "#C2C8CC"
