{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Heartbox",
  "author": "f00",
  "themes": [
    {
      "name": "Heartbox",
      "appearance": "dark",
      "style": {
        "background": "#191413",
        "editor.background": "#191413",
        "editor.foreground": "#E8E4DC",
        "editor.gutter.background": "#191413",
        "editor.line_number": "#3D2F2D",
        "editor.active_line_number": "#C2C8CC",
        "editor.active_line.background": "#3D2F2D",
        "terminal.background": "#191413",
        "terminal.foreground": "#E8E4DC",
        "terminal.ansi.black": "#191413",
        "terminal.ansi.red": "#E5141A",
        "terminal.ansi.green": "#5A8A42",
        "terminal.ansi.yellow": "#D4B84A",
        "terminal.ansi.blue": "#0888ED",
        "terminal.ansi.magenta": "#C97A86",
        "terminal.ansi.cyan": "#47B0F6",
        "terminal.ansi.white": "#E8E4DC",
        "terminal.ansi.bright_black": "#3D2F2D",
        "terminal.ansi.bright_red": "#F53A42",
        "terminal.ansi.bright_green": "#7AAD58",
        "terminal.ansi.bright_yellow": "#E8D46A",
        "terminal.ansi.bright_blue": "#5CB4F0",
        "terminal.ansi.bright_magenta": "#E09AA6",
        "terminal.ansi.bright_cyan": "#7AC4F8",
        "terminal.ansi.bright_white": "#F2EFE8",
        "text": "#E8E4DC",
        "text.muted": "#7A656A",
        "text.accent": "#E5141A",
        "border": "#3A2C30",
        "border.focused": "#E5141A",
        "element.background": "#1A1315",
        "element.hover": "#3D2F2D",
        "element.selected": "#4B1006",
        "elevated_surface.background": "#1A1315",
        "surface.background": "#191413",
        "panel.background": "#1A1315",
        "status_bar.background": "#3D2F2D",
        "title_bar.background": "#191413",
        "tab_bar.background": "#191413",
        "tab.active_background": "#3D2F2D",
        "tab.inactive_background": "#191413",
        "players": [
          {
            "cursor": "#C2C8CC",
            "background": "#C2C8CC",
            "selection": "#4B1006"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#7A656A",
            "font_style": "italic"
          },
          "string": {
            "color": "#D4B84A"
          },
          "number": {
            "color": "#EA5638"
          },
          "keyword": {
            "color": "#C97A86"
          },
          "function": {
            "color": "#0888ED"
          },
          "type": {
            "color": "#0888ED"
          },
          "variable": {
            "color": "#E8E4DC"
          },
          "constant": {
            "color": "#6B4A58"
          },
          "punctuation": {
            "color": "#C2C8CC"
          },
          "tag": {
            "color": "#E5141A"
          },
          "attribute": {
            "color": "#5A8A42"
          },
          "operator": {
            "color": "#C97A86"
          }
        }
      }
    }
  ]
}
