      "rgb": [184, 192, 200],
      "hsl": [210, 13, 75],
      "role": "Cool metal jacket — subtle chrome accent"
    },
    "bright_black": {
      "hex": "#4A3A3E",
      "rgb": [74, 58, 62],
      "hsl": [345, 12, 26],
