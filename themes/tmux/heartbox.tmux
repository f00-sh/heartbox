# Heartbox — tmux
set -g status-style "bg=#142238,fg=#EDE6DE"
set -g message-style "bg=#4E1A22,fg=#EDE6DE"
set -g pane-border-style "fg=#2A3548"
set -g pane-active-border-style "fg=#E03818"
set -g window-status-current-style "bg=#E03818,fg=#0A1528,bold"
set -g window-status-style "fg=#6E7A8A"
set -g mode-style "bg=#4E1A22,fg=#EDE6DE"
set -g clock-mode-colour "#B8C0C8"
