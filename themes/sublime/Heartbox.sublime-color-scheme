{
  "name": "Heartbox",
  "globals": {
    "background": "#090909",
    "foreground": "#EDE6DE",
    "caret": "#B8BEC2",
    "line_highlight": "#1C1617",
    "selection": "#56180A",
    "selection_border": "#3A3232",
    "inactive_selection": "#1C1617",
    "find_highlight": "#C49A3C",
    "find_highlight_foreground": "#090909",
    "brackets_options": "underline",
    "brackets_foreground": "#D44A18",
    "tags_options": "stippled_underline",
    "tags_foreground": "#C47A72",
    "guide": "#3A3232",
    "active_guide": "#B8BEC2",
    "gutter": "#090909",
    "gutter_foreground": "#3A3232"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment",
      "foreground": "#8A7874",
      "font_style": "italic"
    },
    {
      "name": "String",
      "scope": "string",
      "foreground": "#C49A3C"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#C45A20"
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "foreground": "#C47A72"
    },
    {
      "name": "Storage",
      "scope": "storage",
      "foreground": "#C47A72"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, support.function",
      "foreground": "#1E78C8"
    },
    {
      "name": "Class",
      "scope": "entity.name.class, entity.name.type",
      "foreground": "#3D8A48"
    },
    {
      "name": "Constant",
      "scope": "constant",
      "foreground": "#454B93"
    },
    {
      "name": "Variable",
      "scope": "variable",
      "foreground": "#EDE6DE"
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "foreground": "#D44A18"
    },
    {
      "name": "Attribute",
      "scope": "entity.other.attribute-name",
      "foreground": "#3D8A48"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "foreground": "#B8BEC2"
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "foreground": "#EDE6DE",
      "background": "#D44A18"
    }
  ]
}
