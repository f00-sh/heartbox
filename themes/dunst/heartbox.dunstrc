# Heartbox — dunst (fragment; merge into dunstrc)
[global]
    frame_color = "#B8C0C8"
    separator_color = frame

[urgency_low]
    background = "#0A1528"
    foreground = "#EDE6DE"
    frame_color = "#2A3548"

[urgency_normal]
    background = "#0A1528"
    foreground = "#EDE6DE"
    frame_color = "#B8C0C8"

[urgency_critical]
    background = "#0A1528"
    foreground = "#EDE6DE"
    frame_color = "#E03818"
