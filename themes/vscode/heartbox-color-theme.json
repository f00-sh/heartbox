{
  "name": "Heartbox",
  "type": "dark",
  "colors": {
    "editor.background": "#090909",
    "editor.foreground": "#EDE6DE",
    "editor.lineHighlightBackground": "#1C1617",
    "editor.selectionBackground": "#56180A",
    "editorCursor.foreground": "#B8BEC2",
    "editorLineNumber.foreground": "#3A3232",
    "editorLineNumber.activeForeground": "#B8BEC2",
    "sideBar.background": "#141011",
    "sideBar.foreground": "#EDE6DE",
    "activityBar.background": "#090909",
    "activityBar.foreground": "#B8BEC2",
    "statusBar.background": "#1C1617",
    "statusBar.foreground": "#EDE6DE",
    "statusBar.debuggingBackground": "#C50A1B",
    "tab.activeBackground": "#1C1617",
    "tab.inactiveBackground": "#090909",
    "tab.activeForeground": "#EDE6DE",
    "tab.inactiveForeground": "#8A7874",
    "tab.activeBorderTop": "#C50A1B",
    "titleBar.activeBackground": "#090909",
    "titleBar.activeForeground": "#EDE6DE",
    "panel.background": "#141011",
    "panel.border": "#3A3232",
    "focusBorder": "#C50A1B",
    "button.background": "#C50A1B",
    "button.foreground": "#EDE6DE",
    "list.activeSelectionBackground": "#56180A",
    "list.hoverBackground": "#1C1617",
    "list.highlightForeground": "#2096EE",
    "terminal.background": "#090909",
    "terminal.foreground": "#EDE6DE",
    "terminal.ansiBlack": "#090909",
    "terminal.ansiRed": "#C50A1B",
    "terminal.ansiGreen": "#5A8A3A",
    "terminal.ansiYellow": "#D4A83A",
    "terminal.ansiBlue": "#2096EE",
    "terminal.ansiMagenta": "#C47A72",
    "terminal.ansiCyan": "#4AADF5",
    "terminal.ansiWhite": "#EDE6DE",
    "terminal.ansiBrightBlack": "#3A3232",
    "terminal.ansiBrightRed": "#E81420",
    "terminal.ansiBrightGreen": "#7AAD58",
    "terminal.ansiBrightYellow": "#E8C85A",
    "terminal.ansiBrightBlue": "#4AADF5",
    "terminal.ansiBrightMagenta": "#E09A94",
    "terminal.ansiBrightCyan": "#7AC4F8",
    "terminal.ansiBrightWhite": "#F5F1EA",
    "gitDecoration.addedResourceForeground": "#5A8A3A",
    "gitDecoration.deletedResourceForeground": "#C50A1B",
    "gitDecoration.modifiedResourceForeground": "#D4A83A"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#8A7874",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#D4A83A"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#C45A20"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#C47A72"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#2096EE"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#5A8A3A"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#EDE6DE"
      }
    },
    {
      "scope": [
        "constant"
      ],
      "settings": {
        "foreground": "#454B93"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#C50A1B"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#5A8A3A"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B8BEC2"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#C50A1B"
      }
    }
  ]
}
