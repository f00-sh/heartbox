{
  "name": "Heartbox",
  "type": "dark",
  "colors": {
    "editor.background": "#191413",
    "editor.foreground": "#E8E4DC",
    "editor.lineHighlightBackground": "#3D2F2D",
    "editor.selectionBackground": "#4B1006",
    "editorCursor.foreground": "#C2C8CC",
    "editorLineNumber.foreground": "#3D2F2D",
    "editorLineNumber.activeForeground": "#C2C8CC",
    "sideBar.background": "#1A1315",
    "sideBar.foreground": "#E8E4DC",
    "activityBar.background": "#191413",
    "activityBar.foreground": "#C2C8CC",
    "statusBar.background": "#3D2F2D",
    "statusBar.foreground": "#E8E4DC",
    "statusBar.debuggingBackground": "#E5141A",
    "tab.activeBackground": "#3D2F2D",
    "tab.inactiveBackground": "#191413",
    "tab.activeForeground": "#E8E4DC",
    "tab.inactiveForeground": "#7A656A",
    "tab.activeBorderTop": "#E5141A",
    "titleBar.activeBackground": "#191413",
    "titleBar.activeForeground": "#E8E4DC",
    "panel.background": "#1A1315",
    "panel.border": "#3A2C30",
    "focusBorder": "#E5141A",
    "button.background": "#E5141A",
    "button.foreground": "#E8E4DC",
    "list.activeSelectionBackground": "#4B1006",
    "list.hoverBackground": "#3D2F2D",
    "list.highlightForeground": "#0888ED",
    "terminal.background": "#191413",
    "terminal.foreground": "#E8E4DC",
    "terminal.ansiBlack": "#191413",
    "terminal.ansiRed": "#E5141A",
    "terminal.ansiGreen": "#5A8A42",
    "terminal.ansiYellow": "#D4B84A",
    "terminal.ansiBlue": "#0888ED",
    "terminal.ansiMagenta": "#C97A86",
    "terminal.ansiCyan": "#47B0F6",
    "terminal.ansiWhite": "#E8E4DC",
    "terminal.ansiBrightBlack": "#3D2F2D",
    "terminal.ansiBrightRed": "#F53A42",
    "terminal.ansiBrightGreen": "#7AAD58",
    "terminal.ansiBrightYellow": "#E8D46A",
    "terminal.ansiBrightBlue": "#5CB4F0",
    "terminal.ansiBrightMagenta": "#E09AA6",
    "terminal.ansiBrightCyan": "#7AC4F8",
    "terminal.ansiBrightWhite": "#F2EFE8",
    "gitDecoration.addedResourceForeground": "#5A8A42",
    "gitDecoration.deletedResourceForeground": "#E5141A",
    "gitDecoration.modifiedResourceForeground": "#D4B84A"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7A656A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#D4B84A"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#EA5638"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#C97A86"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#0888ED"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#5A8A42"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#E8E4DC"
      }
    },
    {
      "scope": [
        "constant"
      ],
      "settings": {
        "foreground": "#6B4A58"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E5141A"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#5A8A42"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#C2C8CC"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E5141A"
      }
    }
  ]
}
