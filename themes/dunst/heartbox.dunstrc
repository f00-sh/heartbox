# Heartbox — dunst (fragment; merge into dunstrc)
[global]
    frame_color = "#B8BEC2"
    separator_color = frame

[urgency_low]
    background = "#090909"
    foreground = "#EDE6DE"
    frame_color = "#3A3232"

[urgency_normal]
    background = "#090909"
    foreground = "#EDE6DE"
    frame_color = "#B8BEC2"

[urgency_critical]
    background = "#090909"
    foreground = "#EDE6DE"
    frame_color = "#B82E18"
