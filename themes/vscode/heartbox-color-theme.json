{
  "name": "Heartbox",
  "type": "dark",
  "colors": {
    "editor.background": "#0A1528",
    "editor.foreground": "#EDE6DE",
    "editor.lineHighlightBackground": "#142238",
    "editor.selectionBackground": "#4E1A22",
    "editorCursor.foreground": "#B8C0C8",
    "editorLineNumber.foreground": "#2A3548",
    "editorLineNumber.activeForeground": "#B8C0C8",
    "sideBar.background": "#1A2844",
    "sideBar.foreground": "#EDE6DE",
    "activityBar.background": "#0A1528",
    "activityBar.foreground": "#B8C0C8",
    "statusBar.background": "#142238",
    "statusBar.foreground": "#EDE6DE",
    "statusBar.debuggingBackground": "#E03818",
    "tab.activeBackground": "#142238",
    "tab.inactiveBackground": "#0A1528",
    "tab.activeForeground": "#EDE6DE",
    "tab.inactiveForeground": "#6E7A8A",
    "tab.activeBorderTop": "#E03818",
    "titleBar.activeBackground": "#0A1528",
    "titleBar.activeForeground": "#EDE6DE",
    "panel.background": "#1A2844",
    "panel.border": "#2A3548",
    "focusBorder": "#E03818",
    "button.background": "#E03818",
    "button.foreground": "#EDE6DE",
    "list.activeSelectionBackground": "#4E1A22",
    "list.hoverBackground": "#142238",
    "list.highlightForeground": "#1E8AE8",
    "terminal.background": "#0A1528",
    "terminal.foreground": "#EDE6DE",
    "terminal.ansiBlack": "#0A1528",
    "terminal.ansiRed": "#E03818",
    "terminal.ansiGreen": "#3D9650",
    "terminal.ansiYellow": "#D4A838",
    "terminal.ansiBlue": "#1E8AE8",
    "terminal.ansiMagenta": "#D47A82",
    "terminal.ansiCyan": "#3AA0F0",
    "terminal.ansiWhite": "#EDE6DE",
    "terminal.ansiBrightBlack": "#2A3548",
    "terminal.ansiBrightRed": "#F05028",
    "terminal.ansiBrightGreen": "#55A860",
    "terminal.ansiBrightYellow": "#E0BC55",
    "terminal.ansiBrightBlue": "#3AA0F0",
    "terminal.ansiBrightMagenta": "#E09098",
    "terminal.ansiBrightCyan": "#6AB4F5",
    "terminal.ansiBrightWhite": "#E8E2D8",
    "gitDecoration.addedResourceForeground": "#3D9650",
    "gitDecoration.deletedResourceForeground": "#E03818",
    "gitDecoration.modifiedResourceForeground": "#D4A838"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#6E7A8A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#D4A838"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E06028"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#D47A82"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#1E8AE8"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#3D9650"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#EDE6DE"
      }
    },
    {
      "scope": [
        "constant"
      ],
      "settings": {
        "foreground": "#5A4E9E"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E03818"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#3D9650"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B8C0C8"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E03818"
      }
    }
  ]
}
