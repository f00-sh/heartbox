# Heartbox — tmux
set -g status-style "bg=#2C1F22,fg=#F4EBE0"
set -g message-style "bg=#3A2428,fg=#F4EBE0"
set -g pane-border-style "fg=#4A3A3E"
set -g pane-active-border-style "fg=#E02030"
set -g window-status-current-style "bg=#E02030,fg=#1A1214,bold"
set -g window-status-style "fg=#8A6E78"
set -g mode-style "bg=#3A2428,fg=#F4EBE0"
set -g clock-mode-colour "#B8C0C8"
