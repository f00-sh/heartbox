{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Heartbox",
  "author": "f00",
  "themes": [
    {
      "name": "Heartbox",
      "appearance": "dark",
      "style": {
        "background": "#090909",
        "editor.background": "#090909",
        "editor.foreground": "#EDE6DE",
        "editor.gutter.background": "#090909",
        "editor.line_number": "#3A3232",
        "editor.active_line_number": "#B8BEC2",
        "editor.active_line.background": "#1C1617",
        "terminal.background": "#090909",
        "terminal.foreground": "#EDE6DE",
        "terminal.ansi.black": "#090909",
        "terminal.ansi.red": "#D44A18",
        "terminal.ansi.green": "#3D8A48",
        "terminal.ansi.yellow": "#C49A3C",
        "terminal.ansi.blue": "#1E78C8",
        "terminal.ansi.magenta": "#C47A72",
        "terminal.ansi.cyan": "#3A94D8",
        "terminal.ansi.white": "#EDE6DE",
        "terminal.ansi.bright_black": "#3A3232",
        "terminal.ansi.bright_red": "#E86022",
        "terminal.ansi.bright_green": "#5AA05A",
        "terminal.ansi.bright_yellow": "#D4B85A",
        "terminal.ansi.bright_blue": "#3A94D8",
        "terminal.ansi.bright_magenta": "#D49A94",
        "terminal.ansi.bright_cyan": "#6AACC8",
        "terminal.ansi.bright_white": "#E8E2D8",
        "text": "#EDE6DE",
        "text.muted": "#8A7874",
        "text.accent": "#D44A18",
        "border": "#3A3232",
        "border.focused": "#D44A18",
        "element.background": "#141011",
        "element.hover": "#1C1617",
        "element.selected": "#56180A",
        "elevated_surface.background": "#141011",
        "surface.background": "#090909",
        "panel.background": "#141011",
        "status_bar.background": "#1C1617",
        "title_bar.background": "#090909",
        "tab_bar.background": "#090909",
        "tab.active_background": "#1C1617",
        "tab.inactive_background": "#090909",
        "players": [
          {
            "cursor": "#B8BEC2",
            "background": "#B8BEC2",
            "selection": "#56180A"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#8A7874",
            "font_style": "italic"
          },
          "string": {
            "color": "#C49A3C"
          },
          "number": {
            "color": "#C45A20"
          },
          "keyword": {
            "color": "#C47A72"
          },
          "function": {
            "color": "#1E78C8"
          },
          "type": {
            "color": "#1E78C8"
          },
          "variable": {
            "color": "#EDE6DE"
          },
          "constant": {
            "color": "#454B93"
          },
          "punctuation": {
            "color": "#B8BEC2"
          },
          "tag": {
            "color": "#D44A18"
          },
          "attribute": {
            "color": "#3D8A48"
          },
          "operator": {
            "color": "#C47A72"
          }
        }
      }
    }
  ]
}
