# Heartbox — dunst (fragment; merge into dunstrc)
[global]
    frame_color = "#C2C8CC"
    separator_color = frame

[urgency_low]
    background = "#191413"
    foreground = "#E8E4DC"
    frame_color = "#3D2F2D"

[urgency_normal]
    background = "#191413"
    foreground = "#E8E4DC"
    frame_color = "#C2C8CC"

[urgency_critical]
    background = "#191413"
    foreground = "#E8E4DC"
    frame_color = "#E5141A"
