/* Heartbox — rofi */
* {
  background: #0A1528;
  background-alt: #142238;
  foreground: #EDE6DE;
  selected: #E03818;
  active: #1E8AE8;
  urgent: #E06028;
  silver: #B8C0C8;
}
window {
  background-color: @background;
  border: 2px;
  border-color: @silver;
}
mainbox { background-color: @background; }
inputbar {
  background-color: @background-alt;
  text-color: @foreground;
  padding: 8px;
}
listview { background-color: @background; }
element {
  background-color: @background;
  text-color: @foreground;
  padding: 6px;
}
element selected {
  background-color: @selected;
  text-color: @background;
}
