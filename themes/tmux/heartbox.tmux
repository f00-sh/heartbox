# Heartbox — tmux
set -g status-style "bg=#1C1617,fg=#EDE6DE"
set -g message-style "bg=#56180A,fg=#EDE6DE"
set -g pane-border-style "fg=#3A3232"
set -g pane-active-border-style "fg=#B82E18"
set -g window-status-current-style "bg=#B82E18,fg=#090909,bold"
set -g window-status-style "fg=#8A7874"
set -g mode-style "bg=#56180A,fg=#EDE6DE"
set -g clock-mode-colour "#B8BEC2"
