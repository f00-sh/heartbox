# Heartbox — git-delta (include in ~/.gitconfig)
[delta]
    syntax-theme = Heartbox
    plus-style = syntax "#5FBF4A"
    minus-style = syntax "#E02030"
    plus-emph-style = syntax bold "#5FBF4A"
    minus-emph-style = syntax bold "#E02030"
    line-numbers-left-style = "#4A3A3E"
    line-numbers-right-style = "#4A3A3E"
    line-numbers-minus-style = "#E02030"
    line-numbers-plus-style = "#5FBF4A"
    line-numbers-zero-style = "#8A6E78"
    map-styles = bold purple => syntax "#7A5A9E", bold blue => syntax "#5EC8E8", bold cyan => syntax "#5EC8E8", bold yellow => syntax "#E8D45A"
