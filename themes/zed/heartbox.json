{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Heartbox",
  "author": "f00",
  "themes": [
    {
      "name": "Heartbox",
      "appearance": "dark",
      "style": {
        "background": "#0A1528",
        "editor.background": "#0A1528",
        "editor.foreground": "#EDE6DE",
        "editor.gutter.background": "#0A1528",
        "editor.line_number": "#2A3548",
        "editor.active_line_number": "#B8C0C8",
        "editor.active_line.background": "#142238",
        "terminal.background": "#0A1528",
        "terminal.foreground": "#EDE6DE",
        "terminal.ansi.black": "#0A1528",
        "terminal.ansi.red": "#E03818",
        "terminal.ansi.green": "#3D9650",
        "terminal.ansi.yellow": "#D4A838",
        "terminal.ansi.blue": "#1E8AE8",
        "terminal.ansi.magenta": "#D47A82",
        "terminal.ansi.cyan": "#3AA0F0",
        "terminal.ansi.white": "#EDE6DE",
        "terminal.ansi.bright_black": "#2A3548",
        "terminal.ansi.bright_red": "#F05028",
        "terminal.ansi.bright_green": "#55A860",
        "terminal.ansi.bright_yellow": "#E0BC55",
        "terminal.ansi.bright_blue": "#3AA0F0",
        "terminal.ansi.bright_magenta": "#E09098",
        "terminal.ansi.bright_cyan": "#6AB4F5",
        "terminal.ansi.bright_white": "#E8E2D8",
        "text": "#EDE6DE",
        "text.muted": "#6E7A8A",
        "text.accent": "#E03818",
        "border": "#2A3548",
        "border.focused": "#E03818",
        "element.background": "#1A2844",
        "element.hover": "#142238",
        "element.selected": "#4E1A22",
        "elevated_surface.background": "#1A2844",
        "surface.background": "#0A1528",
        "panel.background": "#1A2844",
        "status_bar.background": "#142238",
        "title_bar.background": "#0A1528",
        "tab_bar.background": "#0A1528",
        "tab.active_background": "#142238",
        "tab.inactive_background": "#0A1528",
        "players": [
          {
            "cursor": "#B8C0C8",
            "background": "#B8C0C8",
            "selection": "#4E1A22"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#6E7A8A",
            "font_style": "italic"
          },
          "string": {
            "color": "#D4A838"
          },
          "number": {
            "color": "#E06028"
          },
          "keyword": {
            "color": "#D47A82"
          },
          "function": {
            "color": "#1E8AE8"
          },
          "type": {
            "color": "#1E8AE8"
          },
          "variable": {
            "color": "#EDE6DE"
          },
          "constant": {
            "color": "#5A4E9E"
          },
          "punctuation": {
            "color": "#B8C0C8"
          },
          "tag": {
            "color": "#E03818"
          },
          "attribute": {
            "color": "#3D9650"
          },
          "operator": {
            "color": "#D47A82"
          }
        }
      }
    }
  ]
}
