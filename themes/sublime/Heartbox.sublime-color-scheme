{
  "name": "Heartbox",
  "globals": {
    "background": "#191413",
    "foreground": "#E8E4DC",
    "caret": "#C2C8CC",
    "line_highlight": "#3D2F2D",
    "selection": "#4B1006",
    "selection_border": "#3D2F2D",
    "inactive_selection": "#3D2F2D",
    "find_highlight": "#D4B84A",
    "find_highlight_foreground": "#191413",
    "brackets_options": "underline",
    "brackets_foreground": "#E5141A",
    "tags_options": "stippled_underline",
    "tags_foreground": "#C97A86",
    "guide": "#3D2F2D",
    "active_guide": "#C2C8CC",
    "gutter": "#191413",
    "gutter_foreground": "#3D2F2D"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment",
      "foreground": "#7A656A",
      "font_style": "italic"
    },
    {
      "name": "String",
      "scope": "string",
      "foreground": "#D4B84A"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#EA5638"
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "foreground": "#C97A86"
    },
    {
      "name": "Storage",
      "scope": "storage",
      "foreground": "#C97A86"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, support.function",
      "foreground": "#0888ED"
    },
    {
      "name": "Class",
      "scope": "entity.name.class, entity.name.type",
      "foreground": "#5A8A42"
    },
    {
      "name": "Constant",
      "scope": "constant",
      "foreground": "#6B4A58"
    },
    {
      "name": "Variable",
      "scope": "variable",
      "foreground": "#E8E4DC"
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "foreground": "#E5141A"
    },
    {
      "name": "Attribute",
      "scope": "entity.other.attribute-name",
      "foreground": "#5A8A42"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "foreground": "#C2C8CC"
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "foreground": "#E8E4DC",
      "background": "#E5141A"
    }
  ]
}
