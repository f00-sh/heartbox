/* Heartbox — rofi */
* {
  background: #090909;
  background-alt: #1C1617;
  foreground: #EDE6DE;
  selected: #D44A18;
  active: #1E78C8;
  urgent: #C45A20;
  silver: #B8BEC2;
}
window {
  background-color: @background;
  border: 2px;
  border-color: @silver;
}
mainbox { background-color: @background; }
inputbar {
  background-color: @background-alt;
  text-color: @foreground;
  padding: 8px;
}
listview { background-color: @background; }
element {
  background-color: @background;
  text-color: @foreground;
  padding: 6px;
}
element selected {
  background-color: @selected;
  text-color: @background;
}
