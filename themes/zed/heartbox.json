{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Heartbox",
  "author": "f00",
  "themes": [
    {
      "name": "Heartbox",
      "appearance": "dark",
      "style": {
        "background": "#090909",
        "editor.background": "#090909",
        "editor.foreground": "#EDE6DE",
        "editor.gutter.background": "#090909",
        "editor.line_number": "#3A3232",
        "editor.active_line_number": "#B8BEC2",
        "editor.active_line.background": "#1C1617",
        "terminal.background": "#090909",
        "terminal.foreground": "#EDE6DE",
        "terminal.ansi.black": "#090909",
        "terminal.ansi.red": "#C50A1B",
        "terminal.ansi.green": "#5A8A3A",
        "terminal.ansi.yellow": "#D4A83A",
        "terminal.ansi.blue": "#2096EE",
        "terminal.ansi.magenta": "#C47A72",
        "terminal.ansi.cyan": "#4AADF5",
        "terminal.ansi.white": "#EDE6DE",
        "terminal.ansi.bright_black": "#3A3232",
        "terminal.ansi.bright_red": "#E81420",
        "terminal.ansi.bright_green": "#7AAD58",
        "terminal.ansi.bright_yellow": "#E8C85A",
        "terminal.ansi.bright_blue": "#4AADF5",
        "terminal.ansi.bright_magenta": "#E09A94",
        "terminal.ansi.bright_cyan": "#7AC4F8",
        "terminal.ansi.bright_white": "#F5F1EA",
        "text": "#EDE6DE",
        "text.muted": "#8A7874",
        "text.accent": "#C50A1B",
        "border": "#3A3232",
        "border.focused": "#C50A1B",
        "element.background": "#141011",
        "element.hover": "#1C1617",
        "element.selected": "#56180A",
        "elevated_surface.background": "#141011",
        "surface.background": "#090909",
        "panel.background": "#141011",
        "status_bar.background": "#1C1617",
        "title_bar.background": "#090909",
        "tab_bar.background": "#090909",
        "tab.active_background": "#1C1617",
        "tab.inactive_background": "#090909",
        "players": [
          {
            "cursor": "#B8BEC2",
            "background": "#B8BEC2",
            "selection": "#56180A"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#8A7874",
            "font_style": "italic"
          },
          "string": {
            "color": "#D4A83A"
          },
          "number": {
            "color": "#C45A20"
          },
          "keyword": {
            "color": "#C47A72"
          },
          "function": {
            "color": "#2096EE"
          },
          "type": {
            "color": "#2096EE"
          },
          "variable": {
            "color": "#EDE6DE"
          },
          "constant": {
            "color": "#454B93"
          },
          "punctuation": {
            "color": "#B8BEC2"
          },
          "tag": {
            "color": "#C50A1B"
          },
          "attribute": {
            "color": "#5A8A3A"
          },
          "operator": {
            "color": "#C47A72"
          }
        }
      }
    }
  ]
}
