{
  "name": "Heartbox",
  "globals": {
    "background": "#0A1528",
    "foreground": "#EDE6DE",
    "caret": "#B8C0C8",
    "line_highlight": "#142238",
    "selection": "#4E1A22",
    "selection_border": "#2A3548",
    "inactive_selection": "#142238",
    "find_highlight": "#D4A838",
    "find_highlight_foreground": "#0A1528",
    "brackets_options": "underline",
    "brackets_foreground": "#E03818",
    "tags_options": "stippled_underline",
    "tags_foreground": "#D47A82",
    "guide": "#2A3548",
    "active_guide": "#B8C0C8",
    "gutter": "#0A1528",
    "gutter_foreground": "#2A3548"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment",
      "foreground": "#6E7A8A",
      "font_style": "italic"
    },
    {
      "name": "String",
      "scope": "string",
      "foreground": "#D4A838"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#E06028"
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "foreground": "#D47A82"
    },
    {
      "name": "Storage",
      "scope": "storage",
      "foreground": "#D47A82"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, support.function",
      "foreground": "#1E8AE8"
    },
    {
      "name": "Class",
      "scope": "entity.name.class, entity.name.type",
      "foreground": "#3D9650"
    },
    {
      "name": "Constant",
      "scope": "constant",
      "foreground": "#5A4E9E"
    },
    {
      "name": "Variable",
      "scope": "variable",
      "foreground": "#EDE6DE"
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "foreground": "#E03818"
    },
    {
      "name": "Attribute",
      "scope": "entity.other.attribute-name",
      "foreground": "#3D9650"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "foreground": "#B8C0C8"
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "foreground": "#EDE6DE",
      "background": "#E03818"
    }
  ]
}
